NEXT_PUBLIC_APP_URL=http://localhost:3000
INNERSCRIPT_HOSTED_MODE=false
INNERSCRIPT_AUTH_USERNAME=
INNERSCRIPT_AUTH_PASSWORD=

# Local host path. If Postgres runs in Docker and the app runs on the host, expose db as localhost:5433.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/innerscript

# Separate database used by integration tests. Never point this at your dev database.
# docker-compose.yml exposes the test database on localhost:5434.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/innerscript_test

# Optional AI features. Core journaling must work without this key.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
ANALYSIS_ENABLED=false
ANALYSE_MIN_WORD_COUNT=50
